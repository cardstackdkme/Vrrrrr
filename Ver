-- ============================================================
-- HORSE BOOST + ESP (unchanged from Verfall v2.0)
-- ============================================================

local function findHorse()
    local world  = Workspace:FindFirstChild("World")
    local horses = world and world:FindFirstChild("Horses")
    return horses and horses:FindFirstChild(LocalPlayer.Name .. "_Horse")
end
local function num(v, d) return (type(v) == "number") and v or d end

restoreHorse = function()
    if not Horse.SnapTaken then return end
    local h = findHorse()
    if h then
        pcall(function() h:SetAttribute("MaxStamina", Horse.Orig.MaxStamina) end)
        pcall(function() h:SetAttribute("RegenRate",  Horse.Orig.RegenRate) end)
        pcall(function() h:SetAttribute("MaxSpeed",   Horse.Orig.MaxSpeed) end)
    end
    Horse.SnapTaken = false
    Horse.Orig = {}
end

local HORSE_MAX_STAMINA = 600
local HORSE_REGEN       = 50

-- `h` is optional: the watcher below has already resolved the horse, and re-resolving costs 3
-- FindFirstChild round-trips it does not need to spend.
applyHorseBoost = function(h)
    if not Features.HorseBoost then return end
    h = h or findHorse()
    if not h then return end
    if not Horse.SnapTaken then
        Horse.Orig = {
            MaxStamina = num(h:GetAttribute("MaxStamina"), 600),
            RegenRate  = num(h:GetAttribute("RegenRate"), 50),
            MaxSpeed   = num(h:GetAttribute("MaxSpeed"), 65),
        }
        Horse.SnapTaken = true
    end
    pcall(function() h:SetAttribute("MaxStamina", HORSE_MAX_STAMINA) end)
    pcall(function() h:SetAttribute("Stamina",    HORSE_MAX_STAMINA) end)
    pcall(function() h:SetAttribute("RegenRate",  HORSE_REGEN) end)
    pcall(function() h:SetAttribute("MaxSpeed",   Horse.MaxSpeed) end)
end

-- ⚠ RE-PIN ON RESPAWN. Despawning and re-summoning gives you a BRAND NEW model carrying factory
-- attributes, and applyHorseBoost only ever ran from the toggle and at startup — so the boost
-- silently died the first time you re-summoned and never came back. This watches for the model's
-- IDENTITY changing (by address, since Matcha hands back a fresh shim on every access and comparing
-- the shims themselves is always false) and re-applies immediately, plus a slow re-assert in case
-- the server resets a value on mount.
restoreHorseWatch = function()
    if Pins.Horse then Pins.Horse:Disconnect(); Pins.Horse = nil end
    Horse.LastAddr = nil
end
applyHorseWatch = function()
    restoreHorseWatch()
    local accum, ticks = 0, 0
    Pins.Horse = RunService.Heartbeat:Connect(function(dt)
        if not Features.HorseBoost then return end       -- cheapest guard first
        accum = accum + (dt or 0.016)
        if accum < 1 then return end                      -- 1Hz; 3 FindFirstChild is the whole cost
        accum = 0
        local h = findHorse()
        if not h then
            -- Gone. Drop the snapshot so the NEXT horse records its own factory values instead of
            -- inheriting a dead model's — otherwise "Restore" would write stale numbers.
            Horse.LastAddr, Horse.SnapTaken, Horse.Orig = nil, false, {}
            return
        end
        local a
        pcall(function() a = tostring(h.Address) end)
        if a and a ~= Horse.LastAddr then
            Horse.LastAddr  = a
            Horse.SnapTaken = false                       -- new model -> fresh snapshot
            Horse.Orig      = {}
            ticks = 0
            applyHorseBoost(h)                            -- re-pin the moment it reappears
            return
        end
        -- Same horse: re-assert every 3s rather than every second, so a parked horse costs ~1.3
        -- attribute writes/sec instead of 4.
        ticks = ticks + 1
        if ticks >= 3 then ticks = 0; applyHorseBoost(h) end
    end)
end

-- ============================================================
-- VELO HUD — a single line of plain white text: [ 185 ]
-- ============================================================
-- Drag it anywhere with the left mouse button WHILE THE MENU IS OPEN. Gating on the menu matters:
-- M1 is your attack button, so a HUD that could be grabbed at any time would swallow swings.
-- The position persists to its own small file, same approach as the webhook URL — the UI library's
-- config only knows about its own controls, and a dragged screen position is not one.
local VELO = {
    gen = 0, o = nil,           -- generation token + the Drawing object
    x = nil, y = nil,           -- nil = "not placed yet", resolved to a default on first draw
    size = 15,                  -- text size            (slider)
    pad  = 1,                   -- spaces inside the brackets: 1 -> "[ 124 ]", 0 -> "[124]"
    fontName = "System",        -- resolved against Drawing.Fonts at apply time (dropdown)
    saveAt = nil,               -- debounced write (dragging and sliders both fire continuously)
    Path = CONFIG_DIR .. "/velohud.txt",
    drag = false, dx = 0, dy = 0,
    last = nil,                 -- last rendered string, so we only write .Text when it changes
    lastSize = nil, lastFont = nil,   -- so .Size/.Font are written on change, not every tick
}

-- Which fonts THIS build actually exposes. Discovered rather than hardcoded: Drawing.Fonts differs
-- between executors, and assigning an unknown key would silently set .Font = nil.
-- The names come from the UI library, which is proof of what this executor exposes: it resolves
-- ao.System / ao.SystemBold / ao.UI / ao.Monospace off Drawing.Fonts and uses the results as table
-- KEYS, so they are plain values (numbers) and are safe to assign to .Font at any time.
-- Each index is pcall'd INDIVIDUALLY: one shared pcall around the loop would abandon the whole scan
-- at the first name this build happens not to have.
local VELO_FONTS = {}
do
    for _, n in ipairs({ "System", "SystemBold", "UI", "Monospace", "Plex", "Pixel" }) do
        local v
        pcall(function() v = Drawing.Fonts and Drawing.Fonts[n] end)
        if v ~= nil then VELO_FONTS[#VELO_FONTS + 1] = n end
    end
    if #VELO_FONTS == 0 then VELO_FONTS = { "System" } end
end
local function veloFont(name)
    local f
    pcall(function() f = Drawing.Fonts[name] end)
    if f == nil then pcall(function() f = Drawing.Fonts.System end) end
    return f
end

-- key=value per line, so new settings can be added without breaking an existing file. The very
-- first version of this wrote a bare "x,y" line, so that shape is still accepted.
function VELO.load()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    local exists = false
    pcall(function() exists = isfile(VELO.Path) end)
    if not exists then return end
    local ok, raw = pcall(readfile, VELO.Path)
    if not (ok and type(raw) == "string") then return end
    local x, y = raw:match("^%s*(-?%d+%.?%d*)%s*,%s*(-?%d+%.?%d*)%s*$")   -- legacy "x,y"
    if x and y then VELO.x, VELO.y = tonumber(x), tonumber(y) end
    for k, v in raw:gmatch("(%w+)%s*=%s*([^\r\n]*)") do
        v = (v:gsub("%s+$", ""))
        if     k == "x"    then VELO.x    = tonumber(v) or VELO.x
        elseif k == "y"    then VELO.y    = tonumber(v) or VELO.y
        elseif k == "size" then VELO.size = math.max(6, math.min(tonumber(v) or VELO.size, 64))
        elseif k == "pad"  then VELO.pad  = math.max(0, math.min(tonumber(v) or VELO.pad, 8))
        elseif k == "font" and v ~= "" then VELO.fontName = v end
    end
end

function VELO.save()
    if type(writefile) ~= "function" then return end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(CONFIG_DIR) then
            makefolder(CONFIG_DIR)
        end
    end)
    local out = {}
    -- Only persist the position once it actually has one, or changing a setting before the HUD has
    -- ever been shown would pin it to 0,0 on the next launch.
    if VELO.x and VELO.y then
        out[#out + 1] = "x=" .. math.floor(VELO.x)
        out[#out + 1] = "y=" .. math.floor(VELO.y)
    end
    out[#out + 1] = "size=" .. tostring(VELO.size)
    out[#out + 1] = "pad="  .. tostring(VELO.pad)
    out[#out + 1] = "font=" .. tostring(VELO.fontName)
    pcall(writefile, VELO.Path, table.concat(out, "\n"))
end

VELO.load()

restoreVeloHUD = function()
    VELO.gen = VELO.gen + 1                    -- invalidate any running loop
    if VELO.o then pcall(function() VELO.o:Remove() end); VELO.o = nil end
    VELO.last, VELO.drag = nil, false
    if VELO.saveAt then VELO.saveAt = nil; VELO.save() end   -- flush a pending drag before stopping
end

applyVeloHUD = function()
    restoreVeloHUD()
    VELO.gen = VELO.gen + 1
    local myGen = VELO.gen

    local ok, t = pcall(function()
        local d = Drawing.new("Text")
        d.Size = VELO.size
        d.Center = false
        d.Outline = true                        -- 1px outline; plain white is unreadable on snow
        d.Font = veloFont(VELO.fontName)
        d.Color = Color3.fromRGB(255, 255, 255)
        d.ZIndex = 90
        d.Visible = false
        return d
    end)
    if not (ok and t) then return end
    VELO.o = t
    VELO.lastSize, VELO.lastFont = VELO.size, VELO.fontName

    task.spawn(function()
        local vpW, vpH, vpAccum = 1920, 1080, 99
        local wasDown = false
        while VELO.gen == myGen and GUI.Running and Features.VeloHUD do
            -- viewport only changes on a resize; re-read every ~2s rather than every tick
            vpAccum = vpAccum + 1
            if vpAccum >= 24 then
                vpAccum = 0
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    local vp = cam and cam.ViewportSize
                    if vp then vpW, vpH = vp.X, vp.Y end
                end)
            end
            if not (VELO.x and VELO.y) then VELO.x, VELO.y = vpW * 0.5 - 30, vpH - 120 end

            local speed = 0
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local v = hrp.AssemblyLinearVelocity
                    speed = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
                end
            end)

            -- Size and font are written ONLY when they change — a Drawing property write per tick
            -- would be pointless churn for a value that only moves when you touch a slider.
            if VELO.lastSize ~= VELO.size then VELO.lastSize = VELO.size; t.Size = VELO.size end
            if VELO.lastFont ~= VELO.fontName then
                VELO.lastFont = VELO.fontName
                t.Font = veloFont(VELO.fontName)
            end

            local sp = string.rep(" ", math.max(0, math.floor(VELO.pad or 1)))
            local s = "[" .. sp .. math.floor(speed + 0.5) .. sp .. "]"
            if VELO.last ~= s then VELO.last = s; t.Text = s end

            -- DRAG, only while the menu is open. ismouse1pressed is executor-local and free, so
            -- polling it costs nothing; the menu check keeps M1 usable as the attack button.
            local menuOpen = false
            pcall(function() menuOpen = (LibWindow and LibWindow:IsOpen()) and true or false end)
            local down = false
            if menuOpen then pcall(function() down = ismouse1pressed() end) end
            if menuOpen and down then
                local mx, my = Mouse.X, Mouse.Y
                if not wasDown then
                    -- grab test: approximate the text box from the string length (Matcha's Drawing
                    -- exposes no TextBounds), padded so it is comfortable to hit. Uses VELO.size so
                    -- the hitbox tracks the slider immediately.
                    local w, h = #s * VELO.size * 0.62 + 8, VELO.size + 8
                    if mx >= VELO.x - 4 and mx <= VELO.x + w and my >= VELO.y - 4 and my <= VELO.y + h then
                        VELO.drag, VELO.dx, VELO.dy = true, mx - VELO.x, my - VELO.y
                    end
                elseif VELO.drag then
                    VELO.x, VELO.y = mx - VELO.dx, my - VELO.dy
                    VELO.x = math.max(0, math.min(VELO.x, vpW - 20))
                    VELO.y = math.max(0, math.min(VELO.y, vpH - 20))
                    VELO.saveAt = os.clock() + 0.6      -- debounce: one write when you let go
                end
            elseif VELO.drag then
                VELO.drag = false
            end
            wasDown = down

            if VELO.saveAt and os.clock() >= VELO.saveAt then
                VELO.saveAt = nil
                VELO.save()
            end

            t.Position = Vector2.new(math.floor(VELO.x), math.floor(VELO.y))
            if not t.Visible then t.Visible = true end
            -- 20Hz while idle is plenty for a number; 60Hz while dragging so it tracks the cursor.
            task.wait(VELO.drag and (1 / 60) or (1 / 20))
        end
        if VELO.gen == myGen then
            if VELO.o then pcall(function() VELO.o:Remove() end); VELO.o = nil end
            if VELO.saveAt then VELO.saveAt = nil; VELO.save() end
        end
    end)
end

-- ============================================================
-- COMBAT SKULL — a skull image while WE are flagged InCombat
-- ============================================================
-- The flag lives as an attribute on our own model in Workspace.World.Characters.<name>. It is added
-- dynamically (live-verified: a full attribute dump of that model out of combat does NOT contain it,
-- and a sweep of all 26 players in the server found no combat attribute at all while nobody was
-- fighting), so the poll must treat "absent" and "false" identically — both mean not in combat.
--
-- The casing is NOT assumed. Every other attribute on that model is PascalCase (IsSwinging,
-- FallDamageImmune, CharacterLoaded), so "InCombat" is the odds-on spelling and is tried first as a
-- single cheap GetAttribute. If that keeps coming back nil, a slower GetAttributes() sweep looks for
-- any key that lowercases to "incombat" and caches whatever the real spelling turns out to be.
--
-- Image pipeline copies the UI library's, which is proven on this executor: game:HttpGet returns raw
-- binary, the first two bytes are checked for the PNG magic 0x89 0x50, the bytes are cached to disk
-- with writefile, and Drawing.new("Image").Data takes the raw string.
local SKULL = {
    gen = 0, img = nil, txt = nil,
    x = nil, y = nil, size = 96,
    Path  = CONFIG_DIR .. "/skullhud.txt",
    Img   = CONFIG_DIR .. "/skull.png",
    Url   = "https://raw.githubusercontent.com/cardstackdkme/Vrrrrr/main/skull.png",
    data  = nil,             -- raw PNG bytes once loaded
    tried = false,           -- so a missing image is fetched once, not every frame
    status = "not loaded",
    saveAt = nil,
    drag = false, resize = false, dx = 0, dy = 0,
    inCombat = false,
    preview  = false,        -- placement mode: draw and allow dragging even when out of combat
    raw      = nil,          -- last raw attribute value, surfaced in the panel for diagnosis
    attrKey = "InCombat",    -- replaced if the real attribute turns out to be spelled differently
    model = nil, nextModel = 0, nextSweep = 0,
}

function SKULL.load()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    local exists = false
    pcall(function() exists = isfile(SKULL.Path) end)
    if not exists then return end
    local ok, raw = pcall(readfile, SKULL.Path)
    if not (ok and type(raw) == "string") then return end
    for k, v in raw:gmatch("(%w+)%s*=%s*([^\r\n]*)") do
        v = (v:gsub("%s+$", ""))
        if     k == "x"    then SKULL.x    = tonumber(v) or SKULL.x
        elseif k == "y"    then SKULL.y    = tonumber(v) or SKULL.y
        elseif k == "size" then SKULL.size = math.max(24, math.min(tonumber(v) or SKULL.size, 400)) end
    end
end

function SKULL.save()
    if type(writefile) ~= "function" then return end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(CONFIG_DIR) then
            makefolder(CONFIG_DIR)
        end
    end)
    local out = {}
    if SKULL.x and SKULL.y then
        out[#out + 1] = "x=" .. math.floor(SKULL.x)
        out[#out + 1] = "y=" .. math.floor(SKULL.y)
    end
    out[#out + 1] = "size=" .. math.floor(SKULL.size)
    pcall(writefile, SKULL.Path, table.concat(out, "\n"))
end

-- Raw PNG bytes: disk first, then one network fetch that caches to disk. Returns true if we have
-- something Drawing will accept.
function SKULL.loadImage()
    if SKULL.data then return true end
    if type(readfile) == "function" and type(isfile) == "function" then
        local exists = false
        pcall(function() exists = isfile(SKULL.Img) end)
        if exists then
            local ok, raw = pcall(readfile, SKULL.Img)
            if ok and type(raw) == "string" and #raw > 12 then
                local a, b = string.byte(raw, 1, 2)
                if a == 0x89 and b == 0x50 then      -- PNG magic; a truncated download fails here
                    SKULL.data = raw
                    SKULL.status = "loaded from disk (" .. #raw .. " bytes)"
                    return true
                end
                SKULL.status = "disk file is not a PNG"
            end
        end
    end
    if SKULL.tried then return false end
    SKULL.tried = true                                -- one attempt per session, never per frame
    local body
    pcall(function() body = game:HttpGet(SKULL.Url) end)
    if type(body) == "string" and #body > 12 then
        local a, b = string.byte(body, 1, 2)
        if a == 0x89 and b == 0x50 then
            SKULL.data = body
            SKULL.status = "downloaded (" .. #body .. " bytes)"
            if type(writefile) == "function" then
                pcall(function()
                    if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(CONFIG_DIR) then
                        makefolder(CONFIG_DIR)
                    end
                end)
                pcall(writefile, SKULL.Img, body)     -- cache so the next launch is offline
            end
            return true
        end
    end
    SKULL.status = "no skull.png - drop one in " .. SKULL.Img
    return false
end

-- Our own model, re-resolved only when the cached ref dies (respawn replaces it).
function SKULL.myModel(nowc)
    local m = SKULL.model
    if m then
        local ok, p = pcall(function() return m.Parent end)
        if ok and p then return m end
        SKULL.model = nil
    end
    if nowc < SKULL.nextModel then return nil end
    SKULL.nextModel = nowc + 1                        -- don't hammer the tree while dead/loading
    local folder = Workspace:FindFirstChild("World")
    folder = folder and folder:FindFirstChild("Characters")
    if not folder then return nil end
    SKULL.model = folder:FindFirstChild(LocalPlayer.Name)
    return SKULL.model
end

-- Absent and false mean the same thing. Anything else genuinely truthy counts as in combat, so a
-- build that stores 1 instead of true still works — but the falsey-looking STRINGS are excluded
-- explicitly, because a bridge that hands back "false" or "" or "nil" as text would otherwise read
-- as in-combat forever, which is exactly the "it never turns off" failure.
local function combatTruthy(v)
    if v == nil or v == false or v == 0 then return false end
    if type(v) == "string" then
        local s = string.lower(v)
        if s == "" or s == "false" or s == "nil" or s == "0" then return false end
    end
    return true
end

function SKULL.poll(nowc)
    local m = SKULL.myModel(nowc)
    if not m then SKULL.inCombat = false; SKULL.raw = nil; return end
    local v
    pcall(function() v = m:GetAttribute(SKULL.attrKey) end)
    if v == nil and nowc >= SKULL.nextSweep then
        -- The cheap read found nothing. Twice a second at most, look for a differently-spelled key.
        SKULL.nextSweep = nowc + 2
        local all
        pcall(function() all = m:GetAttributes() end)
        if type(all) == "table" then
            -- ⚠ Matcha's GetAttributes() returns an ARRAY OF NAMES, not a name->value map: it comes
            -- back as {"Age","BandageCount",...}. The previous loop compared the numeric INDEX
            -- against "incombat", so it could never match and this whole fallback was dead code.
            -- Handle both shapes, then read the value with a normal GetAttribute.
            for k, val in pairs(all) do
                local nm = (type(k) == "number" and type(val) == "string") and val or k
                if type(nm) == "string" and string.lower(nm) == "incombat" then
                    SKULL.attrKey = nm
                    pcall(function() v = m:GetAttribute(nm) end)
                    break
                end
            end
        end
    end
    SKULL.raw = v                      -- surfaced in the Misc panel so this is never a guess again
    SKULL.inCombat = combatTruthy(v)
end

restoreCombatSkull = function()
    SKULL.gen = SKULL.gen + 1
    if SKULL.img then pcall(function() SKULL.img:Remove() end); SKULL.img = nil end
    if SKULL.txt then pcall(function() SKULL.txt:Remove() end); SKULL.txt = nil end
    SKULL.drag, SKULL.resize = false, false
    if SKULL.saveAt then SKULL.saveAt = nil; SKULL.save() end
end

applyCombatSkull = function()
    restoreCombatSkull()
    SKULL.gen = SKULL.gen + 1
    local myGen = SKULL.gen
    SKULL.loadImage()

    task.spawn(function()
        local vpW, vpH, vpAccum = 1920, 1080, 99
        local wasDown = false
        while SKULL.gen == myGen and GUI.Running and Features.CombatSkull do
            vpAccum = vpAccum + 1
            if vpAccum >= 20 then
                vpAccum = 0
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    local vp = cam and cam.ViewportSize
                    if vp then vpW, vpH = vp.X, vp.Y end
                end)
            end
            -- default: bottom-left, which is what was asked for
            if not (SKULL.x and SKULL.y) then SKULL.x, SKULL.y = 24, vpH - SKULL.size - 24 end

            local nowc = os.clock()
            pcall(SKULL.poll, nowc)

            -- ⚠ SHOWN ONLY WHEN ACTUALLY IN COMBAT, or when Preview is deliberately switched on.
            -- This used to draw whenever the MENU was open, which was meant as a placement aid but
            -- reads exactly like a stuck detection: open the menu and the skull is there whether or
            -- not InCombat is set. (LibWindow:IsOpen() does work — CreateWindow returns the library
            -- table itself and IsOpen reads its `open` flag — so it was showing, not malfunctioning.)
            -- Placement is now an explicit toggle instead of a side effect of opening the menu.
            local show = SKULL.inCombat or SKULL.preview

            if show and not SKULL.data then SKULL.loadImage() end

            if show and SKULL.data then
                if not SKULL.img then
                    pcall(function()
                        SKULL.img = Drawing.new("Image")
                        SKULL.img.Data = SKULL.data
                        SKULL.img.ZIndex = 90
                        SKULL.img.Visible = false
                    end)
                end
                if SKULL.img then
                    pcall(function()
                        SKULL.img.Position = Vector2.new(math.floor(SKULL.x), math.floor(SKULL.y))
                        SKULL.img.Size = Vector2.new(SKULL.size, SKULL.size)
                        -- dimmed while it is only a placement preview, solid when actually in combat
                        SKULL.img.Transparency = SKULL.inCombat and 1 or 0.45
                        SKULL.img.Visible = true
                    end)
                end
                if SKULL.txt then pcall(function() SKULL.txt.Visible = false end) end
            elseif show then
                -- No PNG yet: say so on screen rather than silently drawing nothing.
                if not SKULL.txt then
                    pcall(function()
                        SKULL.txt = Drawing.new("Text")
                        SKULL.txt.Size = 18
                        SKULL.txt.Center = false
                        SKULL.txt.Outline = true
                        SKULL.txt.Font = Drawing.Fonts.SystemBold or Drawing.Fonts.System
                        SKULL.txt.Color = Color3.fromRGB(235, 40, 40)
                        SKULL.txt.ZIndex = 90
                        SKULL.txt.Visible = false
                    end)
                end
                if SKULL.txt then
                    pcall(function()
                        SKULL.txt.Text = SKULL.inCombat and "IN COMBAT" or "[preview] no skull.png"
                        SKULL.txt.Position = Vector2.new(math.floor(SKULL.x), math.floor(SKULL.y))
                        SKULL.txt.Visible = true
                    end)
                end
                if SKULL.img then pcall(function() SKULL.img.Visible = false end) end
            else
                if SKULL.img then pcall(function() SKULL.img.Visible = false end) end
                if SKULL.txt then pcall(function() SKULL.txt.Visible = false end) end
            end

            -- Drag / resize ONLY in Preview mode. M1 is the attack button, so the HUD must never be
            -- grabbable during normal play; gating on Preview rather than on the menu being open
            -- also means it cannot eat a swing just because the menu happens to be up.
            local down = false
            if SKULL.preview then pcall(function() down = ismouse1pressed() end) end
            if SKULL.preview and down then
                local mx, my = Mouse.X, Mouse.Y
                if not wasDown then
                    local gx, gy = SKULL.x + SKULL.size - 14, SKULL.y + SKULL.size - 14
                    if mx >= gx and mx <= gx + 18 and my >= gy and my <= gy + 18 then
                        SKULL.resize = true                 -- bottom-right corner grip
                        SKULL.dx, SKULL.dy = mx, my
                    elseif mx >= SKULL.x and mx <= SKULL.x + SKULL.size
                       and my >= SKULL.y and my <= SKULL.y + SKULL.size then
                        SKULL.drag = true
                        SKULL.dx, SKULL.dy = mx - SKULL.x, my - SKULL.y
                    end
                elseif SKULL.resize then
                    -- square: drive the size off whichever axis moved further from the grab point
                    local d = math.max(mx - SKULL.dx, my - SKULL.dy)
                    SKULL.size = math.max(24, math.min(SKULL.size + d, 400))
                    SKULL.dx, SKULL.dy = mx, my
                    SKULL.saveAt = os.clock() + 0.6
                elseif SKULL.drag then
                    SKULL.x = math.max(0, math.min(mx - SKULL.dx, vpW - 20))
                    SKULL.y = math.max(0, math.min(my - SKULL.dy, vpH - 20))
                    SKULL.saveAt = os.clock() + 0.6
                end
            elseif SKULL.drag or SKULL.resize then
                SKULL.drag, SKULL.resize = false, false
            end
            wasDown = down

            if SKULL.saveAt and os.clock() >= SKULL.saveAt then
                SKULL.saveAt = nil
                SKULL.save()
            end

            -- 5Hz is plenty for a combat flag; 60Hz only while a drag is actually in progress.
            task.wait((SKULL.drag or SKULL.resize) and (1 / 60) or (1 / 5))
        end
        if SKULL.gen == myGen then
            if SKULL.img then pcall(function() SKULL.img:Remove() end); SKULL.img = nil end
            if SKULL.txt then pcall(function() SKULL.txt:Remove() end); SKULL.txt = nil end
            if SKULL.saveAt then SKULL.saveAt = nil; SKULL.save() end
        end
    end)
end

SKULL.load()

-- ============================================================
-- CRATE ESP — what is in each item crate, and where
-- ============================================================
-- Live-verified structure (2026-08-20). The crates live at
--     Workspace.World.ItemBags.<ToolGiver>.Crate      -- a PART, not the model
-- and THE ATTRIBUTES ARE ON THAT PART, not on the ToolGiver above it. That distinction is the whole
-- reason a first sweep found nothing: every ToolGiver model reports zero attributes of its own.
--     Item   [string]  display name, e.g. "Wood", "Cannonball", "Standard Issue Long Cloak"
--     Amount [number]  how many
--     DropId [string]  same as Item on every sample seen
--     Health [number]  100 (crates are breakable)
-- Measured live: 34 ToolGivers, all 34 carrying a Crate part.
--
-- The map also contains ~432 crate-SHAPED props (Crates / BladeCrate / Crate Cart 2 / Storages).
-- Not one of them has a single attribute, so scanning ItemBags rather than matching on names keeps
-- all of that scenery out for free.
local CRATE = {
    ESP = false,
    MaxDist = 2000, MaxDraw = 40,
    size = 14, fontName = "System",
    r = 255, g = 210, b = 80,          -- per channel so a colourpicker can drive it
    Path = CONFIG_DIR .. "/crateesp.txt",
    saveAt = nil,
    entries = {}, order = nil, oi = 1,
    me = nil, tracked = 0,
    col = nil, colDirty = true,
}

function CRATE.load()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    local exists = false
    pcall(function() exists = isfile(CRATE.Path) end)
    if not exists then return end
    local ok, raw = pcall(readfile, CRATE.Path)
    if not (ok and type(raw) == "string") then return end
    for k, v in raw:gmatch("(%w+)%s*=%s*([^\r\n]*)") do
        v = (v:gsub("%s+$", ""))
        if     k == "size" then CRATE.size    = math.max(8, math.min(tonumber(v) or CRATE.size, 40))
        elseif k == "dist" then CRATE.MaxDist = math.max(50, math.min(tonumber(v) or CRATE.MaxDist, 100000))
        elseif k == "font" and v ~= "" then CRATE.fontName = v
        elseif k == "r" then CRATE.r = tonumber(v) or CRATE.r
        elseif k == "g" then CRATE.g = tonumber(v) or CRATE.g
        elseif k == "b" then CRATE.b = tonumber(v) or CRATE.b end
    end
    CRATE.colDirty = true
end

function CRATE.save()
    if type(writefile) ~= "function" then return end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(CONFIG_DIR) then
            makefolder(CONFIG_DIR)
        end
    end)
    pcall(writefile, CRATE.Path, table.concat({
        "size=" .. math.floor(CRATE.size),
        "dist=" .. math.floor(CRATE.MaxDist),
        "font=" .. tostring(CRATE.fontName),
        "r=" .. math.floor(CRATE.r), "g=" .. math.floor(CRATE.g), "b=" .. math.floor(CRATE.b),
    }, "\n"))
end

-- Read one crate's contents. Cheap: two GetAttribute calls on a part already resolved.
function CRATE.readOne(e)
    local c = e.part
    if not c then return end
    local item, amt
    pcall(function() item = c:GetAttribute("Item") end)
    pcall(function() amt  = c:GetAttribute("Amount") end)
    item = (type(item) == "string" and item ~= "") and item or nil
    amt  = tonumber(amt)
    e.item, e.amount = item, amt
    -- Cache the rendered string. Amount changes when somebody loots, so it is rebuilt only when the
    -- pair actually differs, never per frame.
    local s = (item or "?") .. " : " .. (amt and math.floor(amt) or "?")
    if e.label ~= s then e.label = s; e.dirty = true end
end

-- DISCOVERY. Lists ItemBags and resolves each crate's PART once; attributes ride the slow
-- round-robin below, since realistically only Amount changes.
function CRATE.scan()
    local w = Workspace:FindFirstChild("World")
    local bags = w and w:FindFirstChild("ItemBags")
    if not bags then CRATE.tracked = 0; return end
    local kids
    if not pcall(function() kids = bags:GetChildren() end) then return end
    if not kids then return end
    local present = {}
    for _, m in ipairs(kids) do
        local ad
        pcall(function() ad = tonumber(m.Address) end)
        local key = ad and string.format("%.0f", ad) or nil   -- %.0f, never tostring (sci notation)
        if key then
            present[key] = true
            local e = CRATE.entries[key]
            if not e then
                local part
                pcall(function() part = m:FindFirstChild("Crate") end)
                if part then
                    e = { key = key, model = m, part = part }
                    CRATE.entries[key] = e
                    CRATE.order = nil
                    CRATE.readOne(e)
                    pcall(function() e.pos = part.Position end)   -- crates do not walk; sample once
                end
            else
                e.model = m
            end
        end
    end
    for key, e in pairs(CRATE.entries) do
        if not present[key] then
            if e.bundle then pcall(function() e.bundle:Remove() end) end
            CRATE.entries[key] = nil
            CRATE.order = nil
        end
    end
    local n = 0
    for _ in pairs(CRATE.entries) do n = n + 1 end
    CRATE.tracked = n
end

-- Refresh Amount for a few crates per tick, re-sampling position for the same few in case one was
-- knocked over. Round-robin, so the cost is flat however many crates exist.
function CRATE.refresh()
    local list = CRATE.order
    if not list or CRATE.oi > #list then
        list = {}
        for _, e in pairs(CRATE.entries) do list[#list + 1] = e end
        CRATE.order, CRATE.oi = list, 1
    end
    pcall(function()
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        CRATE.me = hrp and hrp.Position or nil
    end)
    local done = 0
    while CRATE.oi <= #list and done < 5 do
        local e = list[CRATE.oi]
        CRATE.oi = CRATE.oi + 1
        done = done + 1
        if e and CRATE.entries[e.key] then
            local live = false
            if e.part then
                local ok, p = pcall(function() return e.part.Parent end)
                live = (ok and p ~= nil)
            end
            if not live then pcall(function() e.part = e.model and e.model:FindFirstChild("Crate") end) end
            if e.part then
                CRATE.readOne(e)
                pcall(function() e.pos = e.part.Position end)
            end
        end
    end
end

-- RENDERER. Pure: cached positions only, one WorldToScreen per drawn crate, nearest-N capped.
function CRATE.draw()
    if CRATE.colDirty then
        CRATE.colDirty = false
        CRATE.col = Color3.fromRGB(math.floor(CRATE.r), math.floor(CRATE.g), math.floor(CRATE.b))
        for _, e in pairs(CRATE.entries) do e.dirty = true end
    end
    local me = CRATE.me
    local drawn = 0
    for _, e in pairs(CRATE.entries) do
        local shown = false
        if CRATE.ESP and me and e.pos and e.label and drawn < CRATE.MaxDraw then
            local d = (e.pos - me).Magnitude
            if d <= CRATE.MaxDist then
                local ok, screen, on = pcall(WorldToScreen, e.pos + Vector3.new(0, 2.5, 0))
                if ok and screen and on then
                    if not e.bundle then
                        local okB, t = pcall(function()
                            local o = Drawing.new("Text")
                            o.Center = true; o.Outline = true; o.Visible = false; o.ZIndex = 4
                            return o
                        end)
                        e.bundle = okB and t or nil
                        e.dirty = true
                    end
                    local t = e.bundle
                    if t then
                        -- Text/size/font/colour are written only when something actually changed.
                        if e.dirty or e._size ~= CRATE.size or e._font ~= CRATE.fontName then
                            e.dirty = false
                            e._size, e._font = CRATE.size, CRATE.fontName
                            pcall(function()
                                t.Text  = e.label
                                t.Size  = CRATE.size
                                t.Font  = veloFont(CRATE.fontName)   -- the discovered-font helper
                                t.Color = CRATE.col
                            end)
                        end
                        t.Position = Vector2.new(math.floor(screen.X + 0.5), math.floor(screen.Y + 0.5))
                        if not e._vis then t.Visible = true; e._vis = true end
                        shown, drawn = true, drawn + 1
                    end
                end
            end
        end
        if not shown and e.bundle and e._vis then e.bundle.Visible = false; e._vis = false end
    end
end

function CRATE.hideAll()
    for _, e in pairs(CRATE.entries) do
        if e.bundle and e._vis then pcall(function() e.bundle.Visible = false end); e._vis = false end
    end
end

function GUI.CrateCleanup()
    for key, e in pairs(CRATE.entries) do
        if e.bundle then pcall(function() e.bundle:Remove() end) end
        CRATE.entries[key] = nil
    end
    CRATE.order = nil
end

CRATE.load()

-- ============================================================
-- BUFFS — ClientInformation attribute pins
-- HookRange = 1000 : extended grapple distance (confirmed working)
-- GasConservation = 1000 (server clamps to ~2) : slower gas drain (confirmed working)
-- CanRollUnlock : flip CanRoll=true on locked talent categories (Lore/Holy/Unique/etc.)
-- ============================================================

-- Buff target values now live in BuffsState[key].target (user-editable via UI)

-- Titan Anti-Hitbox + No-Attack (part-based, ported from Verfall Old — the proven method).
-- Each titan MODEL holds a "Hitboxes" folder (LeftGrab/RightGrab/LeftStomp/RightStomp/Bite)
-- and a "Detectors" folder. We shrink + kill collision/touch on the relevant parts.
-- Driven by Titans.ChildAdded (each titan as it spawns) + an immediate pass over titans
-- already present, and fully restored when the switches go off.
local TITAN_TINY = Vector3.new(0.01, 0.01, 0.01)

-- `lname` is the pre-lowered part name cached by the registry at resolve time. Passing it keeps this
-- off the bridge entirely: the old caller read part.Name on EVERY pass of EVERY titan.
local function shouldDisableHitbox(lname)
    -- Master switch, checked first: kill EVERY hitbox part whatever it is called. Staff bosses use
    -- move names the per-move toggles below don't know about, so this is the one that works on them.
    if Features.NoAllHitboxes then return true end
    if (lname == "leftgrab" or lname == "rightgrab") and Features.NoGrab then return true end
    if (lname == "leftstomp" or lname == "rightstomp") and Features.NoStomp then return true end
    if lname == "bite" and Features.NoBite then return true end
    -- Ported 2026-07-30. Normal titans expose an exact "Kick"; shifters/Ogres name their hitboxes
    -- after their moves (Punch1/Punch2/Punch3/HeavyAttack, *NapeSwing/*CrawlSwing, LeftEat...), so
    -- those need a substring match. Each toggle owns a DISJOINT set — "swing" deliberately does NOT
    -- claim Bite (No Bite owns it) and "kick" does not claim Stomp (No Stomp owns it), otherwise one
    -- toggle would silently override another and turning it off would look broken.
    local n = lname
    if Features.NoKick  and string.find(n, "kick", 1, true) then return true end
    if Features.NoPunch and (string.find(n, "punch", 1, true) or string.find(n, "heavy", 1, true)) then return true end
    if Features.NoSwing then
        -- "eat" is only 3 chars, so match it as a SUFFIX (LeftEat/RightEat) and explicitly spare a
        -- part literally named "Heat" — a bare find("eat") would swallow it.
        if string.find(n, "swing", 1, true) then return true end
        if n ~= "heat" and string.sub(n, -3) == "eat" then return true end
    end
    return false
end

local function anyTitanFeatureOn()
    return Features.NoGrab or Features.NoStomp or Features.NoBite or Features.NoAttack
        or Features.NoKick or Features.NoPunch or Features.NoSwing or Features.NoAllHitboxes
end

-- ============================================================
-- WORLD REGISTRY — ONE cached view of Workspace.World.{Titans,Characters}
-- ============================================================
-- THE FIX for "full server / horde = unusable" (2026-07-30). In Matcha every instance access is an
-- external ReadProcessMemory pointer-walk, and FindFirstChild is the worst of them (it scans a
-- child list). Before this, FIVE loops each re-walked the whole titan tree on their own timer —
-- the ESP render loop (144Hz!), the anti-hitbox re-assert (3Hz), the hitbox expander (25Hz), the
-- musket extender (15Hz) and the ESP discovery scan. Measured against the code, 30 players plus a
-- 40-titan horde cost on the order of 60,000-100,000 round-trips/sec, against a bridge that
-- comfortably serves a few thousand. That is exactly why the MENU stopped responding: the bridge
-- was saturated, so every click queued behind a backlog of ESP reads.
--
-- Now one loop samples the world and every consumer reads the cache:
--   * refs (HumanoidRootPart, DamagePoints/Nape/Eye, Hitboxes[], Detectors[], Humanoid) resolve
--     ONCE per model lifetime — they cannot change while the model lives
--   * .Address and the lowercased part name are captured at resolve time, so the hot paths that
--     used to re-read them every pass now pay nothing
--   * positions refresh every tick for the nearest HOT_* entries and round-robin for the rest, so
--     cost is bounded by the render cap and NOT by how full the server is
--   * attributes (NapeHealth/Dead) ride a slower round-robin still
-- Keyed by tostring(model.Address) — never by the instance (Matcha returns a fresh shim on every
-- access, so an instance key never matches on a later pass).
local Reg = {
    titans = {}, tList = {}, tFolder = nil, tScanAt = 0, tRR = 0, tAttrRR = 0,
    myPos = nil,
    HZ         = 15,   -- registry tick rate
    HOT_T      = 20,   -- titans whose position refreshes EVERY tick (nearest first)
    SWEEP      = 6,    -- cold entries refreshed per tick, round-robin
    ATTR_SWEEP = 5,    -- entries whose attributes refresh per tick, round-robin
    NAPE_HOT   = 10,   -- titans whose nape position is tracked (aim marker)
    SCAN_EVERY = 1,    -- seconds between folder rescans (models added/removed)
    started    = false,
    onDrop     = nil,  -- set by the ESP block so it can free an entry's Drawing objects
}

local FAR = 1000000000   -- "unknown distance" sentinel (NOT 1e9 — Matcha rejects some sci literals)

Reg.addr = function(inst)
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return tostring(a) end
    return nil
end

-- Resolve World.<name> once; only re-resolve when the cached folder ref dies.
Reg.folder = function(cached, name)
    if cached then
        local ok, p = pcall(function() return cached.Parent end)
        if ok and p then return cached end
    end
    local world = Workspace:FindFirstChild("World")
    if not world then return nil end
    return world:FindFirstChild(name)
end

Reg.byDist = function(a, b) return (a.dist or FAR) < (b.dist or FAR) end

-- Resolve a titan's static refs ONCE. Hitboxes/Detectors parent a frame or two after the model, so
-- this is retried for a few ticks before we give up and mark it resolved anyway.
Reg.resolveTitan = function(e)
    local m = e.model
    if not e.hrp then e.hrp = m:FindFirstChild("HumanoidRootPart") end
    if not e.dp then e.dp = m:FindFirstChild("DamagePoints") end
    if e.dp then
        if not e.nape then
            e.nape = e.dp:FindFirstChild("Nape")
            if e.nape then e.napeAddr = Reg.addr(e.nape) end
        end
        if not e.eye then
            e.eye = e.dp:FindFirstChild("Eye")
            if e.eye then e.eyeAddr = Reg.addr(e.eye) end
        end
    end
    -- Staff bosses/shifters ship NO DamagePoints folder: Nape sits at the model root and the eyes
    -- are LeftEyeHitbox / RightEyeHitbox beside it (live-verified on Workspace.Ogre 2026-08-16).
    -- Without this fallback the expander/musket features can never find a boss's weakpoints.
    if not e.nape then
        e.nape = m:FindFirstChild("Nape")
        if e.nape then e.napeAddr = Reg.addr(e.nape) end
    end
    if not e.eye then
        e.eye = m:FindFirstChild("LeftEyeHitbox") or m:FindFirstChild("RightEyeHitbox")
        if e.eye then e.eyeAddr = Reg.addr(e.eye) end
    end
    if not e.hitboxes then
        local hb = m:FindFirstChild("Hitboxes")
        if hb then
            local t = {}
            for _, p in ipairs(hb:GetChildren()) do
                local nm; pcall(function() nm = p.Name end)
                local a = Reg.addr(p)
                if nm and a then t[#t + 1] = { part = p, addr = a, lname = string.lower(nm) } end
            end
            if #t > 0 then e.hitboxes = t end
        end
    end
    if not e.detectors then
        local ds = m:FindFirstChild("Detectors")
        if ds then
            local t = {}
            for _, p in ipairs(ds:GetChildren()) do
                local a = Reg.addr(p)
                if a then t[#t + 1] = { part = p, addr = a } end
            end
            if #t > 0 then e.detectors = t end
        end
    end
    e.tries = (e.tries or 0) + 1
    -- DamagePoints/Hitboxes parent a frame or more after the model, so keep retrying for a while
    -- before giving up — a titan we mark resolved without a Hitboxes list can never be disabled.
    -- Retries are bounded by the per-tick budget in Reg.tick, so a mass spawn can't burst.
    -- `e.nape ~= nil` satisfies the weakpoint half for bosses, which have no DamagePoints folder —
    -- otherwise every boss burned all 20 retries before being force-resolved.
    e.resolved = (e.hrp ~= nil and e.hitboxes ~= nil and (e.dp ~= nil or e.nape ~= nil)) or e.tries >= 20
end

Reg.samplePos = function(e, myPos)
    local hrp = e.hrp
    if not hrp then return end
    local ok, pos = pcall(function() return hrp.Position end)
    if not (ok and pos) then
        -- The root died or the model was replaced. Drop the ref AND re-open resolution, otherwise
        -- a titan that fails one read is stranded without a position for the rest of its life
        -- (resolveTitan only runs while e.resolved is false) — invisible to the ESP and to every
        -- titan feature. This also self-heals the rare case of an address being reused by a new model.
        e.hrp, e.resolved, e.tries = nil, false, 0
        return
    end
    e.pos = pos
    if myPos then
        local dx, dy, dz = pos.X - myPos.X, pos.Y - myPos.Y, pos.Z - myPos.Z
        e.dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    end
end

-- A titan whose nape is destroyed (NapeHealth <= 0) or that's flagged Dead is a corpse left in the
-- Titans folder. Every consumer skips e.dead so we never spend writes on bodies.
Reg.sampleTitanAttrs = function(e)
    local nh; pcall(function() nh = e.model:GetAttribute("NapeHealth") end)
    nh = tonumber(nh)
    e.napeHp = nh
    if nh and nh <= 0 then
        e.dead = true
    else
        local d = false
        pcall(function() d = e.model:GetAttribute("Dead") == true end)
        e.dead = d
    end
    -- Precompute what the ESP would otherwise rebuild EVERY render frame: the bar fraction, the
    -- colour, and the label string. Doing it here means once per ~0.5s per titan instead of 60x/sec,
    -- and it keeps Color3/string allocation out of the render loop entirely.
    if nh then
        e.maxNape = math.max(e.maxNape or nh, nh)
        local pct = e.maxNape > 0 and math.max(0, math.min(1, nh / e.maxNape)) or 0
        if e.napePct ~= pct then
            e.napePct = pct
            e.napeColor = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(220 * pct), 60)
        end
        e.napeTxt = "Nape " .. math.floor(nh + 0.5)
    else
        e.napePct, e.napeTxt = nil, nil
    end
end

Reg.dropTitan = function(a, e)
    if Reg.onDrop then pcall(Reg.onDrop, e) end
    Reg.titans[a] = nil
end

-- STAFF BOSSES. Shifters (Ogre, Abnormal, ...) are parented at the WORKSPACE ROOT rather than in
-- World.Titans, so the folder scan alone can never see them — which is exactly why none of the
-- anti-hitbox toggles did anything to them. Identify by SHAPE, not by name, so a boss we've never
-- heard of still registers: a top-level Model carrying a Hitboxes folder.
-- Throttled to BOSS_EVERY seconds because Workspace has a lot of direct children and each one is a
-- bridge read; between scans the cached set is replayed into `seen` so bosses aren't dropped.
Reg.bossAt    = 0
Reg.bossSeen  = {}
Reg.BOSS_EVERY = 5

Reg.scanBosses = function(store, seen)
    if not Features.BossScan then Reg.bossSeen = {}; return end
    local nowc = os.clock()
    if nowc < Reg.bossAt then
        for a in pairs(Reg.bossSeen) do seen[a] = true end
        return
    end
    Reg.bossAt = nowc + Reg.BOSS_EVERY
    local kids; local ok = pcall(function() kids = Workspace:GetChildren() end)
    if not ok or type(kids) ~= "table" then
        for a in pairs(Reg.bossSeen) do seen[a] = true end
        return
    end
    local found = {}
    for i = 1, #kids do
        local m = kids[i]
        local cls; pcall(function() cls = m.ClassName end)
        if cls == "Model" then
            local hb; pcall(function() hb = m:FindFirstChild("Hitboxes") end)
            if hb then
                local a = Reg.addr(m)
                if a then
                    found[a] = true
                    seen[a]  = true
                    local e = store[a]
                    if not e then store[a] = { addr = a, model = m, boss = true }
                    else e.model = m; e.boss = true end
                end
            end
        end
    end
    Reg.bossSeen = found
end

Reg.rescanTitans = function()
    Reg.tFolder = Reg.folder(Reg.tFolder, "Titans")
    local f = Reg.tFolder
    local store = Reg.titans
    local seen = {}
    -- The Titans folder may be absent (lobby, or a staff boss spawned outside a round) but a boss
    -- can still be live, so this no longer early-returns and wipes the store.
    if f then
        local kids; local ok = pcall(function() kids = f:GetChildren() end)
        if ok and type(kids) == "table" then
            for i = 1, #kids do
                local m = kids[i]
                local a = Reg.addr(m)
                if a then
                    seen[a] = true
                    local e = store[a]
                    if not e then store[a] = { addr = a, model = m } else e.model = m end
                end
            end
        end
    end
    Reg.scanBosses(store, seen)
    for a, e in pairs(store) do
        if not seen[a] then Reg.dropTitan(a, e) end
    end
    local list = {}
    for _, e in pairs(store) do list[#list + 1] = e end
    Reg.tList = list
end

-- Which consumers currently need the titan half sampled at all.
Reg.wantTitans = function()
    return Features.TitanESP or Features.NapeFollow
        or Features.NoGrab or Features.NoStomp or Features.NoBite or Features.NoAttack
        or Features.NoKick or Features.NoPunch or Features.NoSwing or Features.NoAllHitboxes
end

-- Round-robin a cold slice of `list` (everything past `hot`) through `fn`.
Reg.sweep = function(list, n, hot, cursor, count, fn, arg)
    if n <= hot then return cursor end
    for _ = 1, count do
        cursor = cursor + 1
        if cursor > n or cursor <= hot then cursor = hot + 1 end
        fn(list[cursor], arg)
    end
    return cursor
end

Reg.tick = function()
    local wantT = Reg.wantTitans()
    -- Costs literally nothing while every consumer is off — no point resolving our own position for
    -- an empty world view. (The loop stays alive so toggling a feature takes effect on the next tick.)
    if not wantT then
        if #Reg.tList > 0 then
            for a, e in pairs(Reg.titans) do Reg.dropTitan(a, e) end
            Reg.tList = {}
        end
        return
    end

    -- Our own root position: ONE resolve per tick, shared by the ESP, the expander and the
    -- anti-hitbox range gate. Each of those used to resolve it independently.
    local myPos = nil
    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    if hrp then
        local ok, p = pcall(function() return hrp.Position end)
        if ok then myPos = p end
    end
    Reg.myPos = myPos

    local nowc = os.clock()

    if wantT then
        if nowc >= Reg.tScanAt then
            Reg.tScanAt = nowc + Reg.SCAN_EVERY
            Reg.rescanTitans()
        end
        local list = Reg.tList
        local n = #list
        if n > 0 then
            local budget = 4                                  -- bound new-titan ref resolution per tick
            for i = 1, n do
                local e = list[i]
                if not e.resolved then
                    if budget <= 0 then break end
                    budget = budget - 1
                    pcall(Reg.resolveTitan, e)
                end
            end
            table.sort(list, Reg.byDist)
            local hot = n < Reg.HOT_T and n or Reg.HOT_T
            for i = 1, hot do Reg.samplePos(list[i], myPos) end
            Reg.tRR = Reg.sweep(list, n, hot, Reg.tRR, Reg.SWEEP, Reg.samplePos, myPos)
            for _ = 1, Reg.ATTR_SWEEP do
                Reg.tAttrRR = Reg.tAttrRR + 1
                if Reg.tAttrRR > n then Reg.tAttrRR = 1 end
                pcall(Reg.sampleTitanAttrs, list[Reg.tAttrRR])
            end
            -- Nape world position, for the ESP aim marker only. Skipped entirely when the marker is
            -- off, when HP-only mode is on, or when the expander owns the nape (it moves it to you,
            -- so the real position is meaningless). This used to be 2 FindFirstChild + 1 Position
            -- read PER TITAN PER RENDER FRAME — ~5,000 FindFirstChild/sec on its own.
            if Features.TitanESP and Features.TitanNapeMarker and not Features.TitanHPOnly
               and not Features.NapeFollow then
                local lim = n < Reg.NAPE_HOT and n or Reg.NAPE_HOT
                for i = 1, lim do
                    local e = list[i]
                    if e.nape then
                        local ok, p = pcall(function() return e.nape.Position end)
                        if ok and p then e.napePos = p end
                    end
                end
            end
        end
    elseif #Reg.tList > 0 then
        for a, e in pairs(Reg.titans) do Reg.dropTitan(a, e) end
        Reg.tList = {}
    end
end

Reg.start = function()
    if Reg.started then return end
    Reg.started = true
    task.spawn(function()
        local iv = 1 / Reg.HZ
        while GUI.Running do
            pcall(Reg.tick)
            task.wait(iv)
        end
        Reg.started = false
    end)
end

-- Disable a part (snapshotting its original Size once) or restore it. `want` = should be off.
-- PERF: write ONLY Size. The game's hit/attack checks are geometric (workspace:GetPartsInPart
-- reads the part's Size), CanTouch reads nil in Matcha so writing it is a wasted bridge call,
-- and these parts are already CanCollide=false. One Size write vs the old three → 3x less traffic.
-- KEY BY ADDRESS, NEVER BY THE INSTANCE. In Matcha every instance access hands back a FRESH shim,
-- so `store[part]` written on one pass misses on the next (a == b is false for the same instance).
-- Keyed by the shim this did two bad things: the "snapshot once" guard never tripped, so from the
-- second pass on it recorded the ALREADY-SHRUNK TITAN_TINY as the "original"; and the restore branch
-- was unreachable, so a hitbox could never be put back. Address strings compare by value, so this is
-- correct on any build. Value carries the shim so restore still has something to write to.
local function setPart(store, part, want, addr)
    local k = addr or Reg.addr(part)
    if not k then return end
    if want then
        if store[k] == nil then
            local ok, sz = pcall(function() return part.Size end)
            store[k] = { part = part, size = (ok and sz) or TITAN_TINY }
        end
        pcall(function() part.Size = TITAN_TINY end)
    elseif store[k] ~= nil then
        local s = store[k]
        pcall(function() s.part.Size = s.size end)
        store[k] = nil
    end
end

-- A titan further away than this cannot touch you, so spending writes on it is pure waste. It gets
-- picked up the moment it closes in (the re-assert runs on a distance-sorted list).
local ANTI_RANGE = 350
local ANTI_MAX   = 20   -- hard cap on titans processed per pass, nearest first

-- Sync ONE registry entry's hitbox + detector parts to the current toggle state. Everything here is
-- served from the cache: the part list, each part's address and its lowercased name were resolved
-- once when the titan spawned. The old version re-did FindFirstChild("Hitboxes") + GetChildren +
-- IsA + .Name + .Address for every part on every pass.
local function processTitanEntry(e)
    if e.dead then return end
    local hbs = e.hitboxes
    if hbs then
        for i = 1, #hbs do
            local h = hbs[i]
            setPart(Pins.HitboxOriginals, h.part, shouldDisableHitbox(h.lname), h.addr)
        end
    end
    -- Skip the detector sweep unless No Attack is on, or we still have detectors to put back. It
    -- used to run unconditionally — 13 detector parts x every titan x 3Hz, each costing an .Address
    -- read just to conclude "leave it alone". That was thousands of wasted round-trips/sec whenever
    -- ANY anti-hitbox toggle was on.
    if Features.NoAttack or next(Pins.DetectorOriginals) ~= nil then
        local ds = e.detectors
        if ds then
            for i = 1, #ds do
                local d = ds[i]
                setPart(Pins.DetectorOriginals, d.part, Features.NoAttack, d.addr)
            end
        end
    end
end

local function processAllTitans()
    local list = Reg.tList
    local n = #list
    if n > ANTI_MAX then n = ANTI_MAX end   -- distance-sorted by the registry: nearest first
    for i = 1, n do
        local e = list[i]
        if e.resolved and (not e.dist or e.dist <= ANTI_RANGE) then
            pcall(processTitanEntry, e)
        end
    end
end

-- Restore every part we touched (covers titans no longer in the tree too) and clear.
local function restoreAllTitanParts()
    -- address-keyed now: values are { part = shim, size = originalSize } (see setPart)
    for _, s in pairs(Pins.HitboxOriginals) do
        pcall(function() s.part.Size = s.size end)
    end
    Pins.HitboxOriginals = {}
    for _, s in pairs(Pins.DetectorOriginals) do
        pcall(function() s.part.Size = s.size end)
    end
    Pins.DetectorOriginals = {}
end

-- Size-only re-assert so a server-side re-enable can't stick. 2Hz over the nearest ANTI_MAX titans
-- within ANTI_RANGE, reading a cached part list — so a pass is just a handful of Size writes and
-- costs the same whether there are 5 titans in the area or 60. The server re-enables over SECONDS,
-- so 2Hz beats it comfortably.
local function startTitanRefresh()
    if Pins.AntiTitanLoop then return end
    local accum = 0
    Pins.AntiTitanLoop = RunService.Heartbeat:Connect(function(dt)
        if not anyTitanFeatureOn() then return end
        accum = accum + (dt or 0.016)
        if accum < 0.5 then return end
        accum = 0
        pcall(processAllTitans)
    end)
end
local function stopTitanRefresh()
    if Pins.AntiTitanLoop then pcall(function() Pins.AntiTitanLoop:Disconnect() end); Pins.AntiTitanLoop = nil end
end

-- Single entry point for ALL titan toggles (NoGrab/NoStomp/NoBite/NoKick/NoPunch/NoSwing/NoAttack).
local function syncTitans()
    -- No Attack going OFF has to restore EVERY detector we ever shrank, not just the ones near you
    -- right now — processTitanEntry only visits titans inside ANTI_RANGE, so a titan that wandered
    -- off would otherwise keep its detectors shrunk until unload.
    if not Features.NoAttack and next(Pins.DetectorOriginals) ~= nil then
        for _, s in pairs(Pins.DetectorOriginals) do
            pcall(function() s.part.Size = s.size end)
        end
        Pins.DetectorOriginals = {}
    end
    if anyTitanFeatureOn() then
        Reg.start()
        Reg.tScanAt = 0       -- force a rescan on the next tick so titans spawned since are picked up
        processAllTitans()    -- act on titans already present; restore any type just toggled off
        startTitanRefresh()
    else
        stopTitanRefresh()
        restoreAllTitanParts()  -- everything off → undo it all
    end
end

