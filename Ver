-- WEBHOOK — typed in, not hardcoded, and remembered across launches (CORPSE.Path).
local secWH = tabLogs:Section("Webhook", "Left", "Where deaths get posted")
local whBox = secWH:Textbox("Webhook URL", CORPSE.Webhook, function(s)
