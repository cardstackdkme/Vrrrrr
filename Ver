end):Tooltip("paste your Discord webhook URL here - it is saved to Verfall/webhook.txt automatically")
-- ⚠ KEEP THE LIBRARY CONFIG MANAGER OUT OF THIS BOX. Its serialiser stores every control with a
-- value, and its autoload restores them by CALLING THE SETTER, which fires our callback. A config
-- saved while an older URL was in the box would therefore overwrite the current one AND, via the
-- debounce, write that stale URL back over webhook.txt - destroying the good webhook on disk. The
-- library sets noSave on its own config controls for exactly this reason. webhook.txt owns the URL.
pcall(function() whBox.item.noSave = true end)

local function whSet(url)
    CORPSE.Webhook   = (tostring(url or ""):gsub("%s+", ""))
    CORPSE.lastError = nil
    CORPSE.saveWebhook()                     -- button presses save immediately, no debounce needed
    if whBox then
        -- the fork exposes :Set; fall back to :SetValue on the upstream lib
        if not pcall(function() whBox:Set(CORPSE.Webhook) end) then
            pcall(function() whBox:SetValue(CORPSE.Webhook) end)
        end
    end
end

-- ⚠ MATCHA HAS NO CLIPBOARD READ — pasting into the textbox does not work, and the UI library
-- resolves getclipboard into a local it then never calls (zero call sites). Typing a ~120-character
-- URL by hand is not reasonable, so the supported route is a TEXT FILE: Matcha's file sandbox is a
-- real folder on disk (C:\matcha\workspace), so webhook.txt opens in Notepad like anything else.
-- Paste there, save, press this. A clipboard function is still tried first in case a future build
-- gains one.
secWH:Button("Load from File", function()
    local txt
    for _, name in ipairs({ "getclipboard", "getclipboardtext", "readclipboard" }) do
        local fn = CORPSE.execFn(name)
        if fn then
            local ok, v = pcall(fn)
            if ok and type(v) == "string" and v:match("^%s*https://") then txt = v; break end
        end
    end
    if txt then
        whSet(txt)
        Lib:Notify("Webhook", "loaded from clipboard and saved", 3, "success")
        return
    end
    if CORPSE.loadWebhook() then
        whSet(CORPSE.Webhook)                    -- re-save (harmless) and refresh the textbox
        local ok, why = CORPSE.webhookValid(CORPSE.Webhook)
        Lib:Notify("Webhook", ok and "loaded from webhook.txt" or ("loaded, but " .. why),
            4, ok and "success" or "warning")
    else
        Lib:Notify("Webhook", "no URL found - paste it into " .. CORPSE.Path .. " and save", 7, "warning")
    end
end):Tooltip("reads the URL out of webhook.txt in Matcha's workspace folder - paste it there with Notepad")

