    pcall(function() if GUI.StopEspLoops then GUI.StopEspLoops() end end)
    -- Corpse ESP labels are Drawing objects; clearing GUI.Running only stops the loop, it does not
    -- remove them, so they would hang on screen after unload. Called through GUI because the corpse
