-- WEBHOOK URL: PERSISTENCE, VALIDATION AND THE RAW POST
-- Stored in its own tiny file rather than through the UI library's config manager. The library's
-- autosave is deliberately pinned OFF for the whole session (it re-serialises the entire config and
-- writefile()s it every 1.2s, which is a visible disk-write stutter), and its named-config manager
-- only persists when you explicitly save a profile — neither gives "type it once and it is there
-- next launch". One short file, written once per edit, does.
function CORPSE.loadWebhook()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
    local exists = false
    pcall(function() exists = isfile(CORPSE.Path) end)
    if not exists then return false end
    local ok, raw = pcall(readfile, CORPSE.Path)
    if not (ok and type(raw) == "string") then return false end
    -- Tolerant BY DESIGN: this file is meant to be opened in Notepad and pasted into, so it ships
    -- with an instructions header. Take the first line that actually looks like a URL; ignore blank
    -- lines and both comment styles.
    for line in (raw .. "\n"):gmatch("([^\r\n]*)\r?\n") do
        local s = (line:gsub("%s+", ""))          -- parenthesised: gsub's 2nd return must not leak
        if s ~= "" and s:sub(1, 1) ~= "#" and s:sub(1, 2) ~= "--" and s:match("^https://") then
            CORPSE.Webhook = s
            return true
        end
    end
    return false
end

function CORPSE.saveWebhook()
    if type(writefile) ~= "function" then return end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(CONFIG_DIR) then
            makefolder(CONFIG_DIR)
        end
    end)
    pcall(writefile, CORPSE.Path, tostring(CORPSE.Webhook or ""))
end

-- Shape check only — we cannot ask Discord whether a webhook is live without posting to it. The
-- point is that a typo names itself in the Status panel: Matcha exposes no HTTP status code, so
-- without this a malformed URL is indistinguishable from "the feature is broken".
function CORPSE.webhookValid(u)
    u = tostring(u or "")
    if u == "" then return false, "no webhook set" end
    if not u:match("^https://") then return false, "must start with https://" end
    if not u:find("/api/webhooks/", 1, true) then return false, "not a webhook URL" end
    if not u:match("/api/webhooks/(%d+)/[%w%-_]+") then return false, "missing id/token" end
    return true, "ok"
end

-- Resolve an executor global that may live in getgenv(), _G or shared depending on the build.
-- Mirrors how the UI library resolves iskeypressed/httppost/etc.
function CORPSE.execFn(name)
    local fn
    pcall(function() local g = getgenv(); if g and type(g[name]) == "function" then fn = g[name] end end)
    if type(fn) ~= "function" then pcall(function() if type(_G[name]) == "function" then fn = _G[name] end end) end
    if type(fn) ~= "function" then pcall(function() if type(shared[name]) == "function" then fn = shared[name] end end) end
    return fn
end

-- The raw POST, shared by the corpse feed and the Test button.
-- ⚠ Matcha exposes NO HTTP status code (there is no RequestAsync), so a rejected post is otherwise
-- COMPLETELY silent — no post, no error, nothing to debug. That is exactly how a deleted webhook
-- looked like "the script is broken". Discord does return a JSON error body, so read it back:
--   {"message": "Unknown Webhook", "code": 10015}
-- Called directly, NOT via task.spawn: Matcha is single-threaded and cooperative, so task.spawn
-- never made this async — it only threw the response away. Callers already rate-limit.
function CORPSE.post(body)
    local url = CORPSE.Webhook
    local ok, why = CORPSE.webhookValid(url)
    if not ok then CORPSE.lastError = why; return false end
    local resp
    pcall(function()
        if type(httppost) == "function" then resp = httppost(url, body, "application/json")
        else resp = game:HttpPost(url, body, "application/json") end
    end)
    if type(resp) == "string" and resp:find('"message"', 1, true) then
        CORPSE.lastError = resp:match('"message"%s*:%s*"([^"]*)"') or "rejected"
        return false
    end
    CORPSE.lastError = nil
    CORPSE.sent = CORPSE.sent + 1
    return true
end

-- One-off "does this URL actually work" probe, so a new webhook can be verified immediately
-- instead of waiting for somebody to die.
function CORPSE.testPost()
    return CORPSE.post('{"embeds":[{"title":"Verfall connected",'
        .. '"description":"Corpse log is wired up. Deaths will appear here.",'
        .. '"color":5763719}]}')
end

CORPSE.loadWebhook()

-- Tolerant JSON-ish scanner for the Inventory blob.
--   {"Bandage":{"Amount":5,"HotbarSlot":2,"Metadata":[]},"Flint":{...},...}
-- We only want the item name and its Amount. A truncated tail is expected (see above), so this
-- walks value-by-value and BAILS the moment a value doesn't close, rather than regex-scraping
-- "Amount" globally — which would happily pair the last complete Amount with a half-read name.
local function corpseParseInv(s)
    local items, truncated = {}, false
    if type(s) ~= "string" or #s < 2 then return items, false end
    local i, n = 1, #s
    local function skipWs() while i <= n and s:sub(i, i):match("%s") do i = i + 1 end end
    -- reads a quoted string starting at i (which must be a quote); nil if it never closes
    local function readStr()
        if s:sub(i, i) ~= '"' then return nil end
        i = i + 1
        local out = {}
        while i <= n do
            local c = s:sub(i, i)
            if c == "\\" then out[#out + 1] = s:sub(i + 1, i + 1); i = i + 2
            elseif c == '"' then i = i + 1; return table.concat(out)
            else out[#out + 1] = c; i = i + 1 end
        end
        return nil            -- ran off the end: truncated
    end
    -- consumes a balanced {...} or [...] and returns its raw text; nil if it never closes
    local function readBalanced()
        local open = s:sub(i, i)
        local close = (open == "{") and "}" or "]"
        local start, depth = i, 0
        while i <= n do
            local c = s:sub(i, i)
            if c == '"' then
                if not readStr() then return nil end
            else
                if c == open then depth = depth + 1
                elseif c == close then
                    depth = depth - 1
                    if depth == 0 then i = i + 1; return s:sub(start, i - 1) end
                end
                i = i + 1
            end
        end
        return nil
    end
    skipWs()
    if s:sub(i, i) ~= "{" then return items, true end
    i = i + 1
    while i <= n do
        skipWs()
        local c = s:sub(i, i)
        if c == "}" then break end
        if c == "," then i = i + 1
        elseif c == '"' then
            local name = readStr()
            if not name then truncated = true; break end
            skipWs()
            if s:sub(i, i) ~= ":" then truncated = true; break end
            i = i + 1
            skipWs()
            local vc = s:sub(i, i)
            local raw
            if vc == "{" or vc == "[" then raw = readBalanced()
            elseif vc == '"' then raw = readStr()
            else
                local st = i
                while i <= n and not s:sub(i, i):match("[,}]") do i = i + 1 end
                raw = s:sub(st, i - 1)
                if i > n then raw = nil end       -- number ran off the end
            end
            if not raw then truncated = true; break end
            local amt = tonumber(raw:match('"Amount"%s*:%s*(%-?%d+)') or "") or 1
            items[#items + 1] = { name = name, amount = amt }
        else
            i = i + 1
        end
    end
    return items, truncated
end

-- JSON string escape. Hand-rolled because we hand-roll the payload below.
local function corpseEsc(s)
    s = tostring(s or "")
    s = s:gsub("\\", "\\\\"):gsub('"', '\\"')
    s = s:gsub("[%z\1-\31]", function(c)
        if c == "\n" then return "\\n" end
        if c == "\r" then return "\\r" end
        if c == "\t" then return "\\t" end
        return string.format("\\u%04x", c:byte())
    end)
    return s
end

-- Discord embed. Lore name as the title, username underneath, inventory as an aligned code block
-- so the amounts line up in the client.
--
-- The payload is BUILT BY HAND rather than via HttpService:JSONEncode. Two reasons, the first
-- measured live: Matcha's encoder emits numbers as floats, so `color = 0xC8322D` serialises as
-- "color":13120045.0 — and Discord rejects a non-integer colour with a 400. Matcha cannot read an
-- HTTP status code at all (there is no RequestAsync), so that rejection would be COMPLETELY
-- SILENT: no post, no error, nothing to debug. Second, this game's own notes already flag
-- JSONEncode as unreliable on awkward tables. The shape here is fixed and tiny, so hand-rolling
-- is both safer and shorter than defending against the encoder.
local function corpseSend(e)
    local lines = {}
    for _, it in ipairs(e.items or {}) do
        lines[#lines + 1] = string.format("%-26s x%d", it.name, it.amount)
    end
    if e.truncated then
        lines[#lines + 1] = "Limit Reached."
    end
    local inv = (#lines > 0) and ("```\n" .. table.concat(lines, "\n") .. "\n```") or "_empty_"

    -- Time of death. TimeOfDeath is a Unix epoch, which is what Discord's <t:N:style> token
    -- takes, so it renders in each viewer's OWN timezone. Style :S matches Menu.lua's death log
    -- so both feeds read the same — a short stamp, not the full weekday-and-date form.
    -- The epoch MUST be emitted as an integer: we hand-roll the JSON precisely because Matcha's
    -- encoder would write it as 1786950537.0, and Discord would not parse that as a timestamp.
    local tod = tonumber(e.tod)
    local todText
    if tod and tod > 0 then
        todText = string.format("<t:%d:S>", math.floor(tod))
    else
        todText = "_unknown_"
    end

    -- No "Roblox Username" line here: the title already carries it, so repeating it was noise.
    local desc = table.concat({
        "**Lore Name:** " .. ((e.lore ~= "" and e.lore) or "_none_"),
        "**Time of Death:** " .. todText,
    }, "\n")

    local body = table.concat({
        '{"embeds":[{',
        -- Matches Menu.lua's death-log headline. NOTE: no ** ** markers — Discord does not render
        -- markdown inside an embed TITLE, so asterisks would show up literally.
        '"title":"',       corpseEsc("Player ( " .. ((e.user ~= "" and e.user) or "?") .. " ) Has died."), '",',
        '"description":"', corpseEsc(desc), '",',
        '"color":13120045,',                       -- 0xC8322D as a plain INTEGER literal
        '"fields":[{"name":"', corpseEsc("Inventory (" .. #(e.items or {}) .. ")"), '",',
        '"value":"',       corpseEsc(inv), '"}]',
        '}]}',
    })
    CORPSE.post(body)
end

-- Reads one corpse's attributes. Cheap: 3 GetAttribute calls, only on first sight.
local function corpseRead(m)
    local lore, user, inv = "", "", ""
    local tod
    pcall(function() lore = tostring(m:GetAttribute("LoreName") or "") end)
    pcall(function() user = tostring(m:GetAttribute("PlayerName") or "") end)
    pcall(function() inv  = tostring(m:GetAttribute("Inventory") or "") end)
    -- TimeOfDeath is a Unix epoch NUMBER (e.g. 1786950537). Numbers aren't subject to the
    -- 255-char string cap, so this one always comes back whole.
    pcall(function() tod = tonumber(m:GetAttribute("TimeOfDeath")) end)
    local items, truncated = corpseParseInv(inv)
    return lore, user, items, truncated, tod
end

-- Position source. Corpses are ragdolled models, so PrimaryPart is often nil.
local function corpsePart(m)
    local p
    pcall(function() p = m.PrimaryPart end)
    if p then return p end
    for _, nm in ipairs({ "HumanoidRootPart", "UpperTorso", "Torso", "Head" }) do
        pcall(function() p = m:FindFirstChild(nm) end)
        if p then return p end
    end
    return nil
end

-- DISCOVERY (cheap). Lists the folder and notes which corpses exist. It deliberately does NOT
-- read attributes here — that is the expensive half and it is deferred to CORPSE.work().
--
-- ⚠ My original version did the whole job in this one pass, on the assumption that corpses are
-- "few (single digits)". That was measured in an empty test server and is wrong in a live one.
-- Per NEW corpse it did 4x GetAttribute (the SLOWEST Matcha call, 336-511us each) plus up to 5x
-- FindFirstChild, and then a webhook POST — all synchronously, in one tick. With a pile of fresh
-- bodies that is hundreds of round-trips plus blocking HTTP on a single cooperative thread, i.e.
-- the menu stopping dead on the scan cadence.
function CORPSE.scan()
    local t0 = os.clock()
    local folder = Workspace:FindFirstChild("World")
    folder = folder and folder:FindFirstChild("Corpses")
    if not folder then CORPSE.status = "no Corpses folder"; return end
    local kids
    if not pcall(function() kids = folder:GetChildren() end) then return end
    if not kids then return end
    local present = {}
    for _, m in ipairs(kids) do
        local ad
        pcall(function() ad = tonumber(m.Address) end)
        -- %.0f, never tostring(): a big address stringifies into scientific notation, which
        -- collides distinct corpses onto one key and makes entries churn every scan.
        local key = ad and string.format("%.0f", ad) or nil
        if key then
            present[key] = true
            if not CORPSE.entries[key] and not CORPSE.queued[key] and not CORPSE.bad[key] then
                CORPSE.queued[key] = true
                -- ⚠ STAMP THE SEED DECISION *HERE*, not at adoption time. This loop runs BEFORE
                -- the `CORPSE.seeded = true` at the bottom of this function, so CORPSE.seeded still
                -- holds its PRE-SCAN value — which is the entire point of the flag. Before the
                -- scan/work split the check lived in this same loop and worked; afterwards it was
                -- read in work(), which runs strictly LATER in the same tick and therefore always
                -- saw `true`, so "don't dump the backlog when the toggle is switched on" never fired.
                CORPSE.pending[#CORPSE.pending + 1] =
                    { key = key, model = m, post = (CORPSE.seeded and CORPSE.Log) and true or false }
            end
        end
    end
    -- drop corpses that despawned
    for key, e in pairs(CORPSE.entries) do
        if not present[key] then
            if e.bundle then pcall(function() e.bundle.name:Remove() end) end
            CORPSE.entries[key] = nil
            -- CLEAR `seen` AND `bad` TOO. The key is a raw heap address and Roblox recycles them,
            -- so a brand-new corpse can be allocated on a dead one's address. Leaving the flag set
            -- made that death permanently un-postable while the ESP still drew it perfectly — a
            -- webhook that goes quiet over time for no visible reason.
            CORPSE.seen[key] = nil
            CORPSE.bad[key]  = nil
            CORPSE.order = nil      -- membership changed: rebuild the sampler cursor
        end
    end
    local n = 0
    for _ in pairs(CORPSE.entries) do n = n + 1 end
    CORPSE.tracked = n
    CORPSE.seeded = true
    CORPSE.scanMs = (os.clock() - t0) * 1000
    CORPSE.status = n .. " tracked, " .. CORPSE.sent .. " sent, " .. #CORPSE.pending .. " queued"
end

-- Adopt ONE discovered corpse: read its attributes and enter it into the live set. Shared by the
-- timed work() path and the manual "Queue All Corpses" button so the two can never drift apart
-- again (they did: fetchAll harvested a table only the OTHER path filled). Returns true if adopted.
function CORPSE.adopt(job)
    CORPSE.queued[job.key] = nil
    local m = job.model
    local alive = false
    pcall(function() alive = m.Parent ~= nil end)
    if not alive then
        -- Strike it out rather than silently dropping it. scan() re-queues anything missing from
        -- `entries`, so without a strike count one un-readable model bounces between scan() and
        -- work() forever, keeping `pending` permanently non-empty.
        job.fails = (job.fails or 0) + 1
        if job.fails >= 3 then
            CORPSE.bad[job.key] = true
        else
            CORPSE.queued[job.key] = true
            CORPSE.pending[#CORPSE.pending + 1] = job
        end
        return false
    end
    local lore, user, items, truncated, tod = corpseRead(m)
    local e = { key = job.key, model = m, part = corpsePart(m), lore = lore, user = user,
                items = items, truncated = truncated, tod = tod }
    CORPSE.entries[job.key] = e
    -- APPEND to the sampler cursor instead of nil-ing it. Nil-ing rebuilt the round-robin list from
    -- scratch on every adoption, resetting oi to 1 — so while a queue was draining, only the first
    -- ~6 entries ever got a position and the rest stayed e.pos == nil (invisible to the ESP).
    if CORPSE.order then CORPSE.order[#CORPSE.order + 1] = e end
    -- `job.post` was decided at DISCOVERY time in scan(), while CORPSE.seeded still meant something.
    if job.post and not CORPSE.seen[job.key] then
        CORPSE.enqueue(e)
        CORPSE.seen[job.key] = true
    end
    return true
end

-- Queue one post, refusing to let the backlog grow without bound. An unbounded outbox is how a
-- graveyard turns into several minutes of continuous POSTing, which is what gets a webhook deleted.
function CORPSE.enqueue(e)
    if #CORPSE.outbox >= CORPSE.OutboxMax then
        CORPSE.dropped = CORPSE.dropped + 1
        return false
    end
    CORPSE.outbox[#CORPSE.outbox + 1] = e
    return true
end

-- THE EXPENSIVE HALF, BUDGETED. Runs on every loop tick but reads at most ONE new corpse and sends
-- at most ONE webhook, so neither can ever pile up into a single blocking burst.
function CORPSE.work(nowc)
    -- 1) adopt one queued corpse (4 GetAttribute + up to 5 FindFirstChild)
    if #CORPSE.pending > 0 then
        local t0 = os.clock()
        CORPSE.adopt(table.remove(CORPSE.pending, 1))
        CORPSE.workMs = (os.clock() - t0) * 1000
    end
    -- 2) send at most one webhook, and never more often than once a second.
    -- httppost is a SYNCHRONOUS bridge op — task.spawn does not make it async, because Matcha is
    -- single-threaded and cooperative. Every POST blocks the whole VM for its round-trip.
    --
    -- ⚠ This is deliberately NOT behind an early `return` from step 1 any more. The nextPost gate
    -- below already caps posting at one per second, which is what actually prevented the freeze;
    -- the extra `return` only meant that while ANY corpse was waiting to be read the outbox could
    -- not drain at all — and combined with the re-queue loop above, that silenced the webhook
    -- permanently. One attribute read plus at most one POST per second is a bounded tick.
    if #CORPSE.outbox > 0 and nowc >= (CORPSE.nextPost or 0) then
        CORPSE.nextPost = nowc + (CORPSE.PostEvery or 3)
        local e = table.remove(CORPSE.outbox, 1)
        local t0 = os.clock()
        corpseSend(e)
        CORPSE.postMs = (os.clock() - t0) * 1000
    end
end

-- Manual dump of everything on the ground right now, ignoring the seed rule. QUEUES them rather
-- than sending inline: posting N corpses in a loop would be N blocking HTTP calls back-to-back,
-- which freezes the game for as long as that takes. The outbox drains at 1/sec.
-- ⚠ THE BUG THAT MADE THIS BUTTON DO NOTHING: scan() used to adopt corpses inline, so by the time
-- the harvest loop below ran, CORPSE.entries held every body in the world. After the scan/work
-- split, scan() only fills `pending` — the sole writer of `entries` is work(), on its own timer —
-- so on a fresh run this iterated an EMPTY table, queued 0 and reported success. Adopt what our
-- own scan() just discovered before harvesting.
function CORPSE.fetchAll()
    CORPSE.scan()
    -- This is an explicit, user-initiated one-shot, so the burst of attribute reads is acceptable
    -- here — it was the back-to-back blocking POSTs that froze the game, and those are still capped
    -- at 1/sec by the outbox. We yield every few corpses anyway so a graveyard can't hitch the menu.
    local tries = 0
    while #CORPSE.pending > 0 and tries < 500 do   -- bounded: adopt() can re-queue a failed model
        tries = tries + 1
        CORPSE.adopt(table.remove(CORPSE.pending, 1))
        if tries % 6 == 0 then task.wait() end
    end
    local n = 0
    for _, e in pairs(CORPSE.entries) do
        if not CORPSE.enqueue(e) then break end   -- outbox full; the rest are counted as dropped
        CORPSE.seen[e.key] = true                 -- so the timed path doesn't post it a second time
        n = n + 1
    end
    return n
end

-- SAMPLER (slow). Reads positions off the tree so the renderer never has to. This is the same
-- discipline as the player/titan engine above, and for the same reason: reading .Parent/.Position
-- per corpse per FRAME is a bridge round-trip per corpse per frame, which is precisely the traffic
-- pattern that saturates the bridge and freezes the whole menu.
-- Chunked so a graveyard of bodies can never produce one big synchronous burst.
function CORPSE.sample()
    pcall(function()
        local ch = LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        CORPSE.me = hrp and hrp.Position or nil
    end)
    local list = CORPSE.order
    if not list or CORPSE.oi > #list then
        list = {}
        for _, e in pairs(CORPSE.entries) do list[#list + 1] = e end
        CORPSE.order, CORPSE.oi = list, 1
    end
    local done = 0
    while CORPSE.oi <= #list and done < 6 do          -- at most 6 corpses per tick
        local e = list[CORPSE.oi]
        CORPSE.oi = CORPSE.oi + 1
        done = done + 1
        if e and CORPSE.entries[e.key] then
            -- Only re-resolve the part when we have none AND enough time has passed. Without the
            -- retry gate a corpse whose part never resolves burns 5 lookups every single tick.
            -- pcall returns (success, f's-first-result). The old form here was
            --   ok = pcall(f) and true or false
            -- which consumed ONLY the success flag and threw away the `.Parent ~= nil` answer, so a
            -- corpse whose limb had been destroyed still read as live, was never re-resolved, and
            -- its label stayed pinned to a stale position.
            local ok = false
            if e.part then
                local sOk, live = pcall(function() return e.part.Parent ~= nil end)
                ok = (sOk and live == true)
            end
            if not e.part or not ok then
                local nowc = os.clock()
                if (e.nextPart or 0) <= nowc then
                    e.nextPart = nowc + 3
                    e.part = corpsePart(e.model)
                end
            end
            if e.part then
                local p; pcall(function() p = e.part.Position end)
                e.pos = p
            else
                e.pos = nil
            end
        end
    end
end

-- RENDERER (fast, PURE). Touches no game instances at all — only cached positions and one
-- WorldToScreen per drawn corpse, capped to the nearest few.
function CORPSE.draw()
    local me = CORPSE.me
    local drawn = 0
    for _, e in pairs(CORPSE.entries) do
        local shown = false
        if CORPSE.ESP and me and e.pos and drawn < CORPSE.MaxDraw then
            local d = (e.pos - me).Magnitude
            if d <= CORPSE.MaxDist then
                local ok, screen, on = pcall(WorldToScreen, e.pos + Vector3.new(0, 3, 0))
                if ok and screen and on then
                    if not e.bundle then
                        local okB, b = pcall(function()
                            local t = Drawing.new("Text")
                            t.Size = 13; t.Center = true; t.Outline = true
                            t.Font = Drawing.Fonts.System; t.Visible = false; t.ZIndex = 3
                            t.Color = Color3.fromRGB(235, 90, 85)
                            return { name = t }
                        end)
                        e.bundle = okB and b or nil
                    end
                    if e.bundle then
                        local di = math.floor(d)
                        -- rebuild the string only when the rounded distance changes, not every frame
                        if e.bundle._d ~= di then
                            e.bundle.name.Text = ((e.lore ~= "" and e.lore) or "?")
                                .. "  [" .. ((e.user ~= "" and e.user) or "?") .. "]  " .. di .. "m"
                            e.bundle._d = di
                        end
                        e.bundle.name.Position = Vector2.new(math.floor(screen.X + 0.5), math.floor(screen.Y + 0.5))
                        e.bundle.name.Visible = true
                        e.bundle._vis = true
                        shown, drawn = true, drawn + 1
                    end
                end
            end
        end
        -- Track visibility in a shadow field rather than reading .Visible back off the Drawing.
        -- This mirrors the player/titan renderer's setVis/hideBundle discipline in this same file,
        -- which never reads a Drawing property back either.
        if not shown and e.bundle and e.bundle._vis then
            e.bundle.name.Visible = false
            e.bundle._vis = false
        end
    end
end

-- Hide every corpse label right now. ⚠ THIS IS WHY LABELS LINGERED: the ONLY code that ever set a
-- label invisible lived inside draw(), and draw() is called from inside the loop's
-- `if CORPSE.ESP or CORPSE.Log` gate. Switching Corpse ESP off (with the webhook off too) closed
-- that gate, so draw() was never called again and the last frame's labels stayed on screen
-- permanently — the toggle callback only assigned the flag and touched no Drawing at all.
function CORPSE.hideAll()
    for _, e in pairs(CORPSE.entries) do
        local b = e.bundle
        if b and b.name and b._vis then
            pcall(function() b.name.Visible = false end)
            b._vis = false
        end
    end
end

-- Called by UnloadScript (which is defined ABOVE this block, so it reaches us through GUI).
-- Flush a webhook edit that has not hit its debounce yet. UnloadScript sets GUI.Running = false,
-- which stops the loop that would otherwise do the write, so without this an edit made in the last
-- 1.5s before unload is silently lost and next launch looks like the setting never took.
function GUI.CorpseFlushWebhook()
    if CORPSE.saveAt then CORPSE.saveAt = nil; CORPSE.saveWebhook() end
end

function GUI.CorpseCleanup()
    for key, e in pairs(CORPSE.entries) do
        if e.bundle and e.bundle.name then pcall(function() e.bundle.name:Remove() end) end
        CORPSE.entries[key] = nil
    end
end

-- ⚠ GENERATION TOKEN — this is not optional. Re-running Verfall.lua creates a NEW GUI table, so
-- an old loop's `GUI.Running` stays true forever and it never exits. Every re-run would stack
-- another 30Hz loop, each closed over its OWN CORPSE table, so a loop from a run where you had
-- ESP enabled keeps hammering the bridge and the CURRENT run's toggle cannot reach it. That is
-- exactly the "it lags even when turned off, and eventually crashes" failure. The player/titan
-- engine guards itself the same way with _G.__VERFALL_MATCHA_ESP.
do
    local gen = {}
    _G.__VERFALL_CORPSE = gen
    task.spawn(function()
        local nextScan, nextSample, wasActive = 0, 0, false
        while GUI.Running and _G.__VERFALL_CORPSE == gen do
            local active = CORPSE.ESP or CORPSE.Log
            -- Outstanding work has to keep moving even with BOTH toggles off, or anything the
            -- "Queue All Corpses" button queues sits in the outbox forever — its only consumer
            -- (work) used to live inside the `active` gate, so the button appeared to do nothing.
            local busy = (#CORPSE.outbox > 0) or (#CORPSE.pending > 0) or CRATE.ESP
            pcall(function()
                local nowc = os.clock()
                -- Debounced webhook save, OUTSIDE the active gate so it lands whether or not the
                -- corpse features are on. Typing fires the textbox callback per keystroke; writing
                -- the file per keystroke would be a disk write per character, which is the same
                -- stutter the library's autosave was disabled for. One write, 1.5s after you stop.
                if CORPSE.saveAt and nowc >= CORPSE.saveAt then
                    CORPSE.saveAt = nil
                    CORPSE.saveWebhook()
                end
                -- Velo HUD settings ride the same always-on loop. Their own render loop only runs
                -- while the HUD is ENABLED, so without this a size/font change made with the HUD
                -- switched off would never reach disk.
                if VELO.saveAt and nowc >= VELO.saveAt then
                    VELO.saveAt = nil
                    VELO.save()
                end
                if TPRESET.saveAt and nowc >= TPRESET.saveAt then
                    TPRESET.saveAt = nil
                    TPRESET.save()
                end
                if SKULL.saveAt and nowc >= SKULL.saveAt then
                    SKULL.saveAt = nil
                    SKULL.save()
                end
                if CRATE.saveAt and nowc >= CRATE.saveAt then
                    CRATE.saveAt = nil
                    CRATE.save()
                end
                -- Watch the keybind panel's live position (a table the library publishes by
                -- reference) and persist it a moment after it stops moving. Comparing to the last
                -- written value means a panel that never moves costs one table read per tick and
                -- no disk writes at all.
                local hp = _G.RQHkPos
                if type(hp) == "table" and tonumber(hp.x) and tonumber(hp.y) then
                    local nx, ny = math.floor(hp.x + 0.5), math.floor(hp.y + 0.5)
                    if nx ~= HKPOS.x or ny ~= HKPOS.y then
                        HKPOS.x, HKPOS.y = nx, ny
                        HKPOS.saveAt = nowc + 0.8      -- debounce: one write when the drag settles
                    end
                end
                if HKPOS.saveAt and nowc >= HKPOS.saveAt then
                    HKPOS.saveAt = nil
                    if type(writefile) == "function" and HKPOS.x and HKPOS.y then
                        pcall(function()
                            if type(makefolder) == "function" and type(isfolder) == "function"
                               and not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
                        end)
                        pcall(writefile, HKPOS.Path, "x=" .. HKPOS.x .. "\ny=" .. HKPOS.y)
                    end
                end
                -- Crate ESP rides this loop rather than owning one: scan is 1Hz discovery,
                -- refresh is a 5-per-tick round-robin, draw is pure. Costs nothing while off.
                if CRATE.ESP then
                    if nowc >= (CRATE.nextScan or 0) then CRATE.nextScan = nowc + 1; CRATE.scan() end
                    CRATE.refresh()
                    CRATE.draw()
                elseif CRATE.wasOn then
                    CRATE.hideAll()
                end
                CRATE.wasOn = CRATE.ESP
                if active then
                    if nowc >= nextScan   then nextScan   = nowc + 2;   CORPSE.scan() end
                    if nowc >= nextSample then nextSample = nowc + 0.2; CORPSE.sample() end
                end
                if active or busy then CORPSE.work(nowc) end
                if active then
                    CORPSE.draw()
                elseif wasActive then
                    CORPSE.hideAll()   -- falling edge: draw() is gated off, so clear labels here
                end
            end)
            wasActive = active
            -- Idle cheaply while both switches are off AND nothing is queued: 4Hz is plenty to
            -- notice one being flipped.
            task.wait((active or busy) and (1 / 30) or 0.25)
        end
        -- superseded or unloaded: drop our own Drawings so they can't linger on screen
        pcall(function() if GUI.CorpseCleanup then GUI.CorpseCleanup() end end)
    end)
end

