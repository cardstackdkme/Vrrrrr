            -- The single most useful message this menu can show. "Unknown Webhook" means Discord
            -- deleted it; make a new one and paste it in.
            Lib:Notify("Webhook", "Discord rejected it: " .. tostring(CORPSE.lastError or "?"), 6, "warning")
        end
