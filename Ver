-- CORPSE LOG — ESP over Workspace.World.Corpses + a Discord webhook
-- ============================================================
-- Corpses carry everything we want as ATTRIBUTES: LoreName, PlayerName and an Inventory JSON blob.
--
-- ⚠ Matcha's GetAttribute TRUNCATES strings at 255 characters. Live-measured on two different
-- corpses: both came back at exactly 255 with an unbalanced brace count (7 open / 6 close), i.e.
-- cut mid-object. There is no second copy of the data on the model, and the value string is not
-- reachable by a shallow pointer walk off the instance (I scanned three hops; the only long JSON
-- found that way is Roblox's own policy-service blob, which is a global and identical on every
-- corpse). So the item list can be SHORT on a well-stocked corpse. The parser below stops cleanly
-- at the cut instead of emitting a mangled entry, and the webhook says so when it happens.
--
-- Everything here is READ-ONLY plus one HTTP POST. Nothing is written to the game.
local CORPSE = {
    ESP        = false,        -- draw name/username over corpses
    Log        = false,        -- POST new corpses to the webhook
    -- Set in the Logs tab, not here. Two hardcoded URLs were burned through in a day, so the URL
    -- lives in the UI and persists to CORPSE.Path — swapping one is a paste, not a script edit.
    Webhook    = "",
    Path       = CONFIG_DIR .. "/webhook.txt",
    saveAt     = nil,          -- debounce timer: written this many seconds after the last keystroke
    MaxDist    = 100000,
    MaxDraw    = 12,           -- hard cap on labels per frame, so a graveyard can't flood the renderer
    -- ⚠ DISCORD RATE SAFETY. A webhook may send ~30 messages/minute to a channel. The first version
    -- of this drained the outbox at one POST per SECOND (60/min) — double the ceiling — and the
    -- broken seed gate meant flipping the toggle on queued the ENTIRE graveyard, so it sat at that
    -- rate for minutes. Discord answers sustained abuse by DELETING the webhook, and two webhooks
    -- died back-to-back that way (both verified returning 404 "Unknown Webhook", code 10015).
    -- 3s = 20/min leaves comfortable headroom; the cap stops a backlog from ever getting long.
    PostEvery  = 3,
    OutboxMax  = 40,
    dropped    = 0,            -- posts discarded because the outbox was already full
    lastError  = nil,          -- last error message Discord sent back, surfaced in the Status panel
    me         = nil,          -- our own position, sampled on the slow loop (never per frame)
    order      = nil,          -- round-robin cursor for the chunked position sampler
    oi         = 1,
    entries    = {},           -- [key] = { key, model, part, lore, user, items, truncated, pos, bundle }
    pending    = {},           -- corpses discovered but not yet read (expensive work, 1 per tick)
    queued     = {},           -- [key] = true while it sits in `pending`, so it is queued once
    bad        = {},           -- [key] = true for models that failed liveness 3x; stops a re-queue loop
    outbox     = {},           -- webhook posts waiting to go out, at most 1/sec (HTTP BLOCKS)
    nextPost   = 0,
    scanMs     = 0, workMs = 0, postMs = 0,   -- per-phase cost, surfaced in the Status panel
    seen       = {},           -- [key] = true, so each corpse is posted at most once
    seeded     = false,        -- first scan only records; it never floods the channel on enable
